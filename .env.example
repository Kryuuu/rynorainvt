# ==========================================
# Rynora Invite — Environment Configuration
# ==========================================

# 1. Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Rynora Invite"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Makassar"
NEXT_PUBLIC_DEFAULT_LOCALE="id-ID"

# 2. Supabase Configuration (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Payment Gateway Configuration (Midtrans / Xendit)
# Supported options: midtrans, xendit, sandbox
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_SERVER_KEY=SB-Mid-server-xxxxxxxxx
NEXT_PUBLIC_PAYMENT_CLIENT_KEY=SB-Mid-client-xxxxxxxxx
PAYMENT_WEBHOOK_SECRET=your-webhook-verification-token-or-secret
PAYMENT_IS_PRODUCTION=false

# 4. Storage Buckets (Optional custom bucket names)
NEXT_PUBLIC_SUPABASE_BUCKET_PUBLIC_MEDIA=rynora-public-media
SUPABASE_BUCKET_PRIVATE_VENDOR=rynora-vendor-vault

# 5. Admin Seed / Security Safeguards
INITIAL_ADMIN_EMAIL=ahmadshawity@gmail.com
